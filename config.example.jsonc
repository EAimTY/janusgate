{
    // Minimum log severity emitted to stderr (off, error, warn, info, debug,
    // trace). Defaults to "info" when omitted.
    "log_level": "info",

    // Listen IP address and port (IP:port, e.g. "127.0.0.1:8080"). An IP
    // literal only: DNS names are rejected, because a listener address is a
    // local binding fact.
    "listen": "0.0.0.0:8080",

    // Inbound TLS termination. When present, the listener serves HTTPS using
    // the PEM certificate chain and private key loaded from these paths; when
    // absent, the listener serves plaintext HTTP. Placeholder paths that MUST
    // be replaced with real files before deployment. Changes to the
    // configuration file and to these files are watched and applied without a
    // restart; see README §8.
    "tls": {
        // PEM certificate chain file path, leaf certificate first.
        "certificate": "certificate.pem",
        // PEM private key file path matching the leaf certificate.
        "private_key": "private-key.pem"
    },

    "database": {
        // Path to the in-process Turso SQLite database file.
        "path": "janusgate.db",
        // Maximum number of concurrent database connections in the pool.
        // Defaults to 4 when omitted.
        "max_connections": 4,
        // Maximum time in milliseconds to wait for a free pool connection.
        // Defaults to 5000 when omitted.
        "pool_timeout": 5000
    },

    "management_api": {
        // Management token for /management-api/* (Authorization: <token>).
        // Placeholder value that MUST be replaced with a real secret before
        // deployment; the gateway performs no placeholder detection.
        "token": "CHANGE_ME_MANAGEMENT_TOKEN",
        // Both cors fields — and the whole cors object — may be omitted:
        // allowed_origin then defaults to [] (no cross-origin requests) and
        // allow_private_network to false.
        "cors": {
            // Origin(s) permitted for cross-origin requests. A single string
            // (e.g. "*", "https://dashboard.example.com") or list of strings
            // (e.g. ["*"], ["https://dashboard.example.com"]). Specifying "*"
            // or ["*"] allows any origin; [] disallows all cross-origin requests.
            "allowed_origin": "*",
            // Whether to allow requests from private networks (Private Network Access).
            "allow_private_network": false
        }
    },

    "api": {
        // Outward protocol endpoints (under /api/*) authorize against database-managed API
        // keys (see the management api-keys routes); no secret lives in this section.
        // Both cors fields — and the whole cors object — may be omitted:
        // allowed_origin then defaults to [] (no cross-origin requests) and
        // allow_private_network to false.
        "cors": {
            // Origin(s) permitted for cross-origin requests. A single string
            // (e.g. "*", "https://chat.example.com") or list of strings
            // (e.g. ["*"], ["https://chat.example.com"]). Specifying "*" or
            // ["*"] allows any origin; [] disallows all cross-origin requests.
            "allowed_origin": "*",
            // Whether to allow requests from private networks (Private Network Access).
            "allow_private_network": false
        }
    },

    // Request accounting (README §3 ApiLog Store). The presence of this
    // section is the recording switch: present, one accounting row is recorded
    // per dispatched inference request into the day-partitioned api-log files;
    // absent, none are, while existing api-log files stay readable. Omitting
    // the whole section turns recording off. The path is consumed once at
    // startup, so adding the section or changing its path applies after
    // restart.
    "api_logs": {
        // Directory holding the api-log files (YYYY-MM-DD.db, one per UTC day
        // of the dispatch instant). Created lazily on the first recorded
        // request.
        "path": "api-logs",
        // Retention of the api-log files in whole days: when a new file is
        // created, older files are deleted file-and-all. Defaults to 90.
        "retention_days": 90
    },

    // Positive runtime limits, defaulted as a whole and field by field.
    "pooling": {
        "quota_refresh_interval_seconds": 60,
        "sticky_idle_timeout_seconds": 86400,
        "sticky_retry_timeout_seconds": 60,
        "sticky_maximum_entries": 100000
    }

    // Remote-compaction sealing keys (README §6.8). The presence of this
    // section is the switch for the gateway's sealed compaction artifacts:
    // present, gateway summaries and wrapped native windows are sealed under
    // these keys; absent, any operation that would produce or consume a
    // sealed carrier fails while native passthrough keeps working. The first
    // key seals; every configured key unseals by its carrier-carried id, so
    // keys rotate by appending and removing a key intentionally invalidates
    // its artifacts. Key changes apply at the next compaction operation — no
    // restart required. Each id must be non-empty, unique, and free of ".";
    // each key is standard base64 of exactly 32 bytes
    // (e.g. `openssl rand -base64 32`).
    // "compaction": {
    //     "keys": [
    //         {
    //             "id": "primary",
    //             "key": "CHANGE_ME_STANDARD_BASE64_32_BYTES"
    //         }
    //     ]
    // }
}
