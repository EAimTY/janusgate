{
    "name": "janusgate-web",
    "version": "0.0.0",
    "license": "Apache-2.0",
    "private": true,
    "type": "module",
    "dependencies": {
        "@solidjs/web": "^2.0.0-rc.13",
        "i18next": "^26.4.2",
        "solid-js": "^2.0.0-rc.13"
    },
    "devDependencies": {
        "@solidjs/vite-plugin": "^3.0.0-next.35",
        "@tailwindcss/vite": "^4.3.3",
        "jsdom": "^30.1.2",
        "typescript": "^7.0.2",
        "vite": "^8.3.3",
        "vitest": "^4.1.11"
    },
    "scripts": {
        "generate-bindings": "rm -rf $PWD/src/management-api/generated && cargo run --locked --manifest-path ../Cargo.toml --bin generate-management-api-typescript-bindings --features management-api-typescript-bindings -- $PWD/src/management-api/generated",
        "dev": "vite",
        "build": "npm run check:i18n && vite build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "check:i18n": "node scripts/check-i18n.mjs"
    }
}
