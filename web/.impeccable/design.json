    "narrative": {
        "northStar": "One page, one job.",
        "overview": "The console gives an operator one clear job per page. Overview reads health and traffic; lists lead to a resource; its detail page explains state; its editor owns changes. Pools and public routes use dedicated editors. Physical availability, public exposure, and serving-key permission remain distinct.\n\nThe visual system is quiet and flat: green-tinted neutrals, one teal action accent, and semantic status hues. System fonts and inline SVG supply the materials; there are no remote visual assets. Light and dark themes share roles and follow the OS unless overridden. Motion conveys a state change, then stops.",
        "keyCharacteristics": [
            "One page, one job; explicit resource and action ownership.",
            "Flat bordered surfaces, compact controls, and generous grouping.",
            "One sans stack for copy; mono tabular figures for machine values.",
            "Status always includes words and an icon.",
            "Localized copy, narrow layouts, visible focus, and reduced motion."
        ],
        "rules": [
            {
                "name": "The Status Rule",
                "body": "A status uses words and an icon, with a semantic tint as reinforcement. A color-only dot does not establish state.",
                "section": "colors"
            },
            {
                "name": "The Data Rule",
                "body": "Machine identifiers, prefixes, counts, and timestamps use the mono stack and tabular figures; explanatory prose stays sans. Isolate machine text as LTR and foreign/user text with automatic direction.",
                "section": "typography"
            },
            {
                "name": "The Ownership Rule",
                "body": "Rows link to the resource that owns their state. Refresh does not erase a dirty draft, and a save result stays beside its action.",
                "section": "layout"
            },
            {
                "name": "The Notice Rule",
                "body": "State the action result where it happened. Use an authored title, preserve the gateway detail, and name a recovery only when known. Failure notices use role=\"alert\".",
                "section": "components"
            }
        ],
        "dos": [
            "Do reuse semantic tokens in both themes.",
            "Do use clear labels, explicit unknown values, and labelled status icons.",
            "Do group related settings and keep save/revert actions with their form.",
            "Do accommodate translated copy and isolate machine values.",
            "Do preserve keyboard focus and respect reduced motion."
        ],
        "donts": [
            "Don't introduce inline row editors or ordinary confirmation modals.",
            "Don't use color as the only signal or conflate permission with availability.",
            "Don't add shadows, gradients, glass, display fonts, or external visual assets.",
            "Don't animate table rows or orchestrate page children.",
            "Don't encode English-only text or volatile page inventories in visual tokens."
        ]
    }
}
