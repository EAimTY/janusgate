{
    "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
    "vcs": {
        "clientKind": "git",
        "enabled": true,
        "root": ".",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**"
        ]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100,
        "attributePosition": "multiline",
        "expand": "always"
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on",
                "useSortedProperties": "on"
            }
        }
    },
    "linter": {
        "rules": {
            "preset": "recommended",
            "complexity": {
                "useLiteralKeys": "off"
            },
            "style": {
                "noNonNullAssertion": "off"
            },
            "correctness": {
                "noUnknownTypeSelector": "off"
            },
            "suspicious": {
                "noConstEnum": "off"
            }
        }
    },
    "javascript": {
        "parser": {
            "jsxEverywhere": false
        },
        "formatter": {
            "enabled": true,
            "quoteStyle": "double",
            "trailingCommas": "all",
            "semicolons": "always",
            "arrowParentheses": "always"
        },
        "linter": {
            "enabled": true
        },
        "assist": {
            "enabled": true
        }
    },
    "json": {
        "formatter": {
            "enabled": true
        },
        "linter": {
            "enabled": true
        },
        "assist": {
            "enabled": true
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        },
        "formatter": {
            "enabled": true
        },
        "linter": {
            "enabled": true
        },
        "assist": {
            "enabled": true
        }
    }
}
