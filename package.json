{
    "name": "janusgate",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "dependencies": {
        "@solidjs/web": "^2.0.0-rc.6",
        "hono": "^4.13.7",
        "solid-js": "^2.0.0-rc.6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "@cloudflare/vitest-plugin": "^1.1.5",
        "@solidjs/vite-plugin": "^3.0.0-next.35",
        "@tailwindcss/vite": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "wrangler": "^4.129.1"
    },
    "scripts": {
        "build": "npm run worker-typegen && vite build --config panel/vite.config.ts",
        "deploy": "npm run worker-typegen && npm run build && wrangler deploy",
        "worker-typegen": "wrangler types worker-bindings.d.ts",
        "typecheck": "npm run worker-typegen && tsc --noEmit --project . && tsc --noEmit --project panel",
        "check": "biome check && npm run typecheck",
        "fix": "npm run typecheck && biome check --write --unsafe",
        "test": "vitest run"
    }
}
